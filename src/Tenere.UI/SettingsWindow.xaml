<Window x:Class="Tenere.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tenere.Shared.Localization;assembly=Tenere.Shared"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource SettingsTitle}"
        Height="620" Width="620" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Background="{DynamicResource SidebarBackgroundBrush}">
            <TextBlock Text="{DynamicResource SettingsTitle}"
                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="24,0,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8B9;" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource GeneralSection}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                              SelectedValue="{Binding Language}" SelectedValuePath="Tag"
                              AutomationProperties.AutomationId="LanguageCombo">
                        <ComboBoxItem Tag="en" Content="English" />
                        <ComboBoxItem Tag="ru" Content="Русский" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="{DynamicResource ThemeLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                              SelectedValue="{Binding Theme}" SelectedValuePath="Tag"
                              AutomationProperties.AutomationId="ThemeCombo">
                        <ComboBoxItem Tag="system" Content="System" />
                        <ComboBoxItem Tag="light" Content="Light" />
                        <ComboBoxItem Tag="dark" Content="Dark" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="{DynamicResource HotkeyLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="{DynamicResource HistorySection}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource RetentionLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="{DynamicResource PrivacySection}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox Content="{DynamicResource PrivacyShieldLabel}"
                          IsChecked="{Binding PrivacyShieldEnabled}" Margin="0,0,0,10" />
                <TextBlock Text="{DynamicResource ExcludedAppsLabel}" Margin="0,4,0,4" />
                <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding ExcludedApps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                <TextBlock Text="{DynamicResource OcrSection}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox Content="{DynamicResource OcrEnabledLabel}"
                          IsChecked="{Binding OcrEnabled}" Margin="0,0,0,20" />

                <TextBlock Text="{DynamicResource PasteSection}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox Content="{DynamicResource PlainTextDefaultLabel}"
                          IsChecked="{Binding PlainTextDefault}" Margin="0,0,0,16" />

                <TextBlock Text="{DynamicResource AppRules}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Rules}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ChainJson}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Content="{DynamicResource Delete}"
                                        Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Padding="10,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ProcessName}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding NewChainSteps, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ChainSteps}" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="{DynamicResource AddRule}"
                            Command="{Binding AddRuleCommand}" Padding="10,4" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,24,20">
            <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}"
                    Width="100" Margin="0,0,10,0" />
            <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}"
                    AutomationProperties.AutomationId="SaveButton" Width="100" />
        </StackPanel>
    </Grid>
</Window>
