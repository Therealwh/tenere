<Window x:Class="Tenere.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tenere.Shared.Localization;assembly=Tenere.Shared"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Source={x:Static loc:Strings.SettingsTitle}}"
        Height="620" Width="620" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Background="{DynamicResource SidebarBackgroundBrush}">
            <TextBlock Text="{Binding Source={x:Static loc:Strings.SettingsTitle}}"
                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="24,0,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8B9;" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:Strings.GeneralSection}}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:Strings.LanguageLabel}}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                              AutomationProperties.AutomationId="LanguageCombo" />
                    <TextBlock Grid.Row="1" Text="{Binding Source={x:Static loc:Strings.ThemeLabel}}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                              AutomationProperties.AutomationId="ThemeCombo" />
                    <TextBlock Grid.Row="2" Text="{Binding Source={x:Static loc:Strings.HotkeyLabel}}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="{Binding Source={x:Static loc:Strings.HistorySection}}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static loc:Strings.RetentionLabel}}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" VerticalContentAlignment="Center"
                             Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="{Binding Source={x:Static loc:Strings.PrivacySection}}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox Content="{Binding Source={x:Static loc:Strings.PrivacyShieldLabel}}"
                          IsChecked="{Binding PrivacyShieldEnabled}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Source={x:Static loc:Strings.ExcludedAppsLabel}}" Margin="0,4,0,4" />
                <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding ExcludedApps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                <TextBlock Text="{Binding Source={x:Static loc:Strings.OcrSection}}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox Content="{Binding Source={x:Static loc:Strings.OcrEnabledLabel}}"
                          IsChecked="{Binding OcrEnabled}" Margin="0,0,0,20" />

                <TextBlock Text="{Binding Source={x:Static loc:Strings.PasteSection}}" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <CheckBox Content="{Binding Source={x:Static loc:Strings.PlainTextDefaultLabel}}"
                          IsChecked="{Binding PlainTextDefault}" Margin="0,0,0,16" />

                <TextBlock Text="{Binding Source={x:Static loc:Strings.AppRules}}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Rules}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ChainJson}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Content="{Binding Source={x:Static loc:Strings.Delete}}"
                                        Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Padding="10,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding Source={x:Static loc:Strings.ProcessName}}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding NewChainSteps, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding Source={x:Static loc:Strings.ChainSteps}}" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="{Binding Source={x:Static loc:Strings.AddRule}}"
                            Command="{Binding AddRuleCommand}" Padding="10,4" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,24,20">
            <Button Content="{Binding Source={x:Static loc:Strings.Cancel}}" Command="{Binding CancelCommand}"
                    Width="100" Margin="0,0,10,0" />
            <Button Content="{Binding Source={x:Static loc:Strings.Save}}" Command="{Binding SaveCommand}"
                    Width="100" />
        </StackPanel>
    </Grid>
</Window>