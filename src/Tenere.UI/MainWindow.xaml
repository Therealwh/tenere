<Window x:Class="Tenere.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:Tenere.UI.Converters"
        xmlns:vm="clr-namespace:Tenere.UI.ViewModels"
        xmlns:models="clr-namespace:Tenere.Core.Models;assembly=Tenere.Core"
        xmlns:loc="clr-namespace:Tenere.Shared.Localization;assembly=Tenere.Shared"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:Strings.AppName}}"
        Height="680" Width="1120"
        MinHeight="480" MinWidth="760"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:ContentTypeToIcon x:Key="ContentTypeToIcon" />
        <conv:BoolToOpacity x:Key="BoolToOpacity" />
        <conv:NullToVisibility x:Key="NullToVisibility" />
        <conv:DateToRelative x:Key="DateToRelative" />
        <conv:BoolToVisibility x:Key="BoolToVisibility" />

        <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ClipCardTemplate" DataType="{x:Type models:ClipItem}">
            <Border CornerRadius="12" Padding="14" Margin="20,0,20,8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Top" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ContentType, Converter={StaticResource ContentTypeToIcon}}"
                                   FontFamily="{DynamicResource IconFontFamily}" FontSize="19"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" MinWidth="0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PlainText}" FontSize="12.5" MaxHeight="36"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"
                                   Visibility="{Binding PlainText, Converter={StaticResource NullToVisibility}}" />

                        <Image Source="{Binding ImagePath}" MaxHeight="170" Stretch="Uniform"
                               HorizontalAlignment="Left" Margin="0,8,0,0"
                               Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding SourceApp}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateToRelative}}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding OcrText, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding Source={x:Static loc:Strings.Ocr}}" FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="&#xE718;" FontFamily="{DynamicResource IconFontFamily}" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                   Margin="0,0,2,0"
                                   Opacity="{Binding Pinned, Converter={StaticResource BoolToOpacity}}" />
                        <Button Style="{StaticResource CardActionButtonStyle}" ToolTip="{Binding Source={x:Static loc:Strings.Paste}}"
                                Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" Content="&#xE77F;" />
                        <Button Style="{StaticResource CardActionButtonStyle}" ToolTip="{Binding Source={x:Static loc:Strings.Pin}}"
                                Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" Content="&#xE718;" />
                        <Button Style="{StaticResource CardActionButtonStyle}" ToolTip="{Binding Source={x:Static loc:Strings.Delete}}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" Content="&#xE711;" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,16,24">
                    <TextBlock Text="{Binding Source={x:Static loc:Strings.AppName}}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Tagline}}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource SidebarNavActiveStyle}" Content="{Binding Source={x:Static loc:Strings.History}}" Margin="12,0" />
                    <TextBlock Text="{Binding Source={x:Static loc:Strings.Collections}}" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="24,18,12,6" />
                    <ListBox ItemsSource="{Binding Collections}" Background="Transparent" BorderThickness="0"
                             Margin="12,0" AutomationProperties.AutomationId="CollectionsList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarNavButtonStyle}"
                                        Content="{Binding Name}"
                                        Command="{Binding DataContext.MoveToCollectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" HorizontalContentAlignment="Left" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="16,4,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Source={x:Static loc:Strings.NewCollection}}"
                                 Height="26" FontSize="11" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="+" Width="26" Height="26" Margin="4,0,0,0"
                                Command="{Binding NewCollectionCommand}"
                                ToolTip="{Binding Source={x:Static loc:Strings.NewCollection}}" />
                    </Grid>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Content="{Binding Source={x:Static loc:Strings.Settings}}"
                            Command="{Binding OpenSettingsCommand}" Margin="12,18,12,0" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource SidebarNavButtonStyle}"
                        Content="{Binding Source={x:Static loc:Strings.ClearAll}}"
                        Command="{Binding ClearCommand}" Margin="12,16,12,20" />
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="{Binding Source={x:Static loc:Strings.AppName}}" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="Maximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8B9;" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- Search -->
            <Border Grid.Row="1" Height="46" Margin="24,4,24,8" CornerRadius="12"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                               Foreground="{DynamicResource SubtleIconBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox"
                             Margin="40,0,12,0" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" FontSize="14"
                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Source={x:Static loc:Strings.SearchPlaceholder}}" FontSize="14"
                               Margin="40,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </Border>

            <!-- Filter chips -->
            <ListBox Grid.Row="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                     Background="Transparent" BorderThickness="0" Margin="24,0,24,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chip" CornerRadius="8" Padding="14,6"
                                            Background="{DynamicResource ChipBackgroundBrush}"
                                            TextElement.Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Chip" Property="TextElement.Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                            <Setter TargetName="Chip" Property="TextElement.Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Clip cards -->
            <Grid Grid.Row="3">
                <ListBox x:Name="ClipList" AutomationProperties.AutomationId="ClipList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource ClipCardTemplate}"
                         ItemContainerStyle="{StaticResource CardContainerStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsContainerVirtualizable="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="46"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Source={x:Static loc:Strings.EmptyTitle}}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Source={x:Static loc:Strings.EmptyHint}}" FontSize="12.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <ProgressBar Height="2" VerticalAlignment="Top" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0" Background="Transparent"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="4" Background="{DynamicResource StatusBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding ItemCount, StringFormat='Items: {0}'}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>