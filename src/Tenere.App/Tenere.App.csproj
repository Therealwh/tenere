<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Tenere</AssemblyName>
    <AssemblyTitle>Tenere</AssemblyTitle>
    <Product>Tenere</Product>
    <Company>Tenere</Company>
    <Description>A fast, private clipboard manager that remembers everything you copy.</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tenere.Shared\Tenere.Shared.csproj" />
    <ProjectReference Include="..\Tenere.UI\Tenere.UI.csproj" />
    <ProjectReference Include="..\Tenere.Core\Tenere.Core.csproj" />
    <ProjectReference Include="..\Tenere.Data\Tenere.Data.csproj" />
    <ProjectReference Include="..\Tenere.Platform\Tenere.Platform.csproj" />
    <ProjectReference Include="..\Tenere.Ocr\Tenere.Ocr.csproj" />
    <ProjectReference Include="..\Tenere.Updater\Tenere.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>

</Project>